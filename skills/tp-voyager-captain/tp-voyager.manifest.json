{
  "schema": "tp-voyager.manifest/v1",
  "skill": {
    "name": "tp-voyager-captain",
    "version": "1.0.9.2",
    "protocol": "tp-voyager-captain/v1"
  },
  "mcp": {
    "name": "tp_voyager",
    "transport": "stdio",
    "command": [
      "python",
      "-m",
      "agent_runtime.server"
    ],
    "cwd": {
      "binding": "repository_root",
      "required": true
    },
    "env": {},
    "required_captain_tools": [
      "voyager_overview",
      "render_voyager_panel",
      "crew_catalog",
      "crew_health",
      "crew_recommend",
      "task_dispatch",
      "task_result"
    ]
  },
  "doctor": {
    "command": [
      "python",
      "-m",
      "agent_runtime.cli",
      "doctor",
      "--json"
    ],
    "schema": "tp-voyager.doctor/v1"
  }
}
