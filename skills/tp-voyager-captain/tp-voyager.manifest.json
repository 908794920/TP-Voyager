{
  "schema": "tp-voyager.manifest/v1",
  "skill": {
    "name": "tp-voyager-captain",
    "version": "1.0.6",
    "protocol": "tp-voyager-captain/v1"
  },
  "mcp": {
    "name": "tp_voyager",
    "transport": "stdio",
    "command": [
      "python",
      "-m",
      "agent_runtime.server"
    ],
    "cwd": {
      "binding": "repository_root",
      "required": true
    },
    "env": {
      "QODER_CLI_PATH": {
        "literal": "~\\.agent-runtime\\bin\\qodercli-qoder-client.cmd"
      },
      "CODEBUDDY_CODE_PATH": {
        "binding": "CODEBUDDY_CODE_PATH",
        "required": true
      }
    },
    "required_captain_tools": [
      "voyager_overview",
      "crew_catalog",
      "crew_health",
      "crew_recommend",
      "task_dispatch",
      "task_result"
    ]
  },
  "doctor": {
    "command": [
      "python",
      "-m",
      "agent_runtime.cli",
      "doctor",
      "--json"
    ],
    "schema": "tp-voyager.doctor/v1"
  }
}
