{
  "schema": "tp-voyager.manifest/v1",
  "skill": {
    "name": "tp-voyager-captain",
    "version": "1.0.3",
    "protocol": "tp-voyager-captain/v1"
  },
  "mcp": {
    "transport": "stdio",
    "command": ["python", "-m", "agent_runtime.server"],
    "required_captain_tools": [
      "voyager_overview",
      "crew_catalog",
      "crew_health",
      "crew_recommend",
      "task_dispatch",
      "task_result"
    ]
  },
  "doctor": {
    "command": ["python", "-m", "agent_runtime.cli", "doctor", "--json"],
    "schema": "tp-voyager.doctor/v1"
  }
}
